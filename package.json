{
  "name": "@snowui/components-pro",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.20.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/SnowUI/SnowUI-Pro.git"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./component-catalog.json": "./component-catalog.json"
  },
  "files": [
    "src",
    "component-catalog.json",
    "README.md"
  ],
  "scripts": {
    "check": "svelte-check --workspace .",
    "catalog:generate": "node scripts/generate-component-catalog.mjs",
    "catalog:check": "node scripts/generate-component-catalog.mjs --check",
    "pack:check": "npm pack --dry-run --cache ./node_modules/.cache/npm",
    "prepublishOnly": "pnpm catalog:check && pnpm check"
  },
  "peerDependencies": {
    "@snowui-design-system/components": ">=0.2.0-alpha.8 <1.0.0",
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "d3-shape": "^3.2.0"
  },
  "devDependencies": {
    "@snowui-design-system/components": "0.2.0-alpha.9",
    "@snowui-design-system/resource-svelte": "1.0.29",
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@tsconfig/svelte": "^5.0.0",
    "@types/d3-shape": "^3.1.8",
    "svelte": "^5.45.2",
    "svelte-check": "^4.3.4",
    "typescript": "^5.0.0",
    "vite": "^5.4.0"
  }
}
