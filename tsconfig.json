{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable", "ES2022.Intl"],
    "moduleResolution": "bundler",
    "customConditions": ["svelte"],
    "types": ["vite/client"],
    "verbatimModuleSyntax": true,
    "paths": {
      "@snowui-design-system/components/internal/component-icon": [
        "../components/src/internal/component-icon/index.ts",
        "./node_modules/@snowui-design-system/components/src/internal/component-icon/index.ts"
      ]
    }
  },
  "include": ["src/**/*.d.ts", "src/**/*.ts", "src/**/*.svelte"]
}
